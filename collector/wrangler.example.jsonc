{
  "name": "trolley-run-collector",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "vars": { "ALLOWED_ORIGINS": "https://ammarphp.github.io" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "trolley-runs",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
