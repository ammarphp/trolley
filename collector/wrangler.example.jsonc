{
  "name": "trolley-run-collector",
  "main": "entry.js",
  "compatibility_date": "2026-09-22",
  "vars": { "ALLOWED_ORIGINS": "https://ammarphp.github.io", "V2_ENABLED": "false", "V2_APPROVED_MANIFEST_HASHES": "" },
  "triggers": { "crons": ["13 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "trolley-runs",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
